#!/usr/bin/env python3
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from gen import args, emit, rng

a = args()
r = rng(a.seed)
alphabet = bytes(range(0x20, 0x7f))


def frames():
    while True:
        rows = b"".join(b"\x1b[%d;1H" % (y + 1) + bytes(r.choices(alphabet, k=80)) for y in range(24))
        yield b"\x1b[?2026h" + rows + b"\x1b[?2026l"


emit(frames(), a.bytes)
