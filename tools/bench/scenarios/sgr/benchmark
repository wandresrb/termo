#!/usr/bin/env python3
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from gen import args, emit, rng

a = args()
r = rng(a.seed)
alphabet = bytes(range(0x21, 0x7f))


def sgr() -> bytes:
    k = r.randrange(5)
    if k == 0:
        return b"\x1b[38;5;%dm" % r.randrange(256)
    if k == 1:
        return b"\x1b[48;5;%dm" % r.randrange(256)
    if k == 2:
        return b"\x1b[38;2;%d;%d;%dm" % (r.randrange(256), r.randrange(256), r.randrange(256))
    if k == 3:
        return b"\x1b[%dm" % r.choice([1, 3, 4, 7, 9, 22, 23, 24, 27, 29])
    return b"\x1b[0m"


def lines():
    while True:
        yield b"".join(sgr() + bytes([r.choice(alphabet)]) for _ in range(79)) + b"\x1b[0m\n"


emit(lines(), a.bytes)
