#!/usr/bin/env python3
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from gen import args, emit, rng

a = args()
r = rng(a.seed)
alphabet = bytes(range(0x20, 0x7f))


def lines():
    while True:
        yield bytes(r.choices(alphabet, k=79)) + b"\n"


emit(lines(), a.bytes)
