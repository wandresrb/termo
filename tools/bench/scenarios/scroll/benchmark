#!/usr/bin/env python3
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from gen import args, emit, rng

a = args()
r = rng(a.seed)
alphabet = bytes(range(0x61, 0x7b))


def lines():
    n = 0
    while True:
        n += 1
        yield b"%08d " % n + bytes(r.choices(alphabet, k=r.randrange(4, 24))) + b"\n"


emit(lines(), a.bytes)
